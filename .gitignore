.venv/
__pycache__/

# large or personal – never commit
models/
recordings/
sessions/
config.json
config.json.*
tasks.json
tasks.json.*
/tasks/
history.json
history.json.*
corrections.json
corrections.json.*
ducked.json*
autopilot.json*
statusline-previous.json
*.log
portable

# generated at runtime (cache/ now; assets/ in older versions)
cache/
assets/*.wav
assets/chevron.png

# build outputs (build/build_installer.py, whisper build)
build/cache/
build/tools/
build/dist/
build/output/

# what Claude Code lays beside a mod it loaded (its API types, a tsconfig extending them)
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

# research for Pepa from another session (competitors): not part of the app, the repo is public
reports/
research_notes/

# what the web statistics write on the server (visits, the admin password hash, the server key): never in the repo
web/site/data/*
!web/site/data/.htaccess

# the intro video for the website, exported from video/ (scripts/export-web.mjs, ~50 MB with its music, which may not be
# shared on its own): published by web/publish.py, rebuilt from the video project
web/site/assets/video/
