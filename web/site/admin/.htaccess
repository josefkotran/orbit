# The statistics page (admin/index.php, behind a password). Its own, stricter rules than the page: no inline script,
# forms only to itself, never cached or indexed.
DirectoryIndex index.php
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "same-origin"
</IfModule>
